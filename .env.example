# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/immo_plus

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=1h

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Redis (BullMQ queue) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Cloudflare R2 (file storage) ─────────────────────────────────────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=immo-plus
R2_PUBLIC_URL=https://files.example.com

# ─── Cloudflare Turnstile (anti-bot protection for public forms) ───────────────
# Get keys at: https://dash.cloudflare.com/ → Turnstile
# Test keys (always pass / always fail): https://developers.cloudflare.com/turnstile/reference/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ─── SMTP (email delivery) ────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
